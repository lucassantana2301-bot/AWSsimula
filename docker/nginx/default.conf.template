# CloudQuest: arquivos estáticos + /api encaminhado ao serviço da API.
# Gerado na subida do contêiner (envsubst da imagem nginx-unprivileged):
# ${API_UPSTREAM} vem do ambiente (Compose ou Kubernetes).
# Cabeçalhos de segurança espelham o vercel.json; ficam num include porque
# add_header dentro de location substitui os do nível de cima.

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;
    absolute_redirect off;
    client_max_body_size 16k;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml application/manifest+json text/plain;
    gzip_min_length 1024;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok";
    }

    location /api/ {
        limit_except GET HEAD { deny all; }
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        # sobrescreve (não acrescenta): o cliente não consegue escolher o IP que a API vê
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_connect_timeout 3s;
        proxy_read_timeout 12s;
        include /etc/nginx/snippets/seguranca.conf;
    }

    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        include /etc/nginx/snippets/seguranca.conf;
    }

    location = /sw.js {
        # types vazio: sem isso o mime.types manda application/javascript
        types { }
        default_type "text/javascript; charset=utf-8";
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/snippets/seguranca.conf;
    }

    location = /manifest.webmanifest {
        types { }
        default_type application/manifest+json;
        add_header Cache-Control "public, max-age=3600" always;
        include /etc/nginx/snippets/seguranca.conf;
    }

    location / {
        try_files $uri $uri.html $uri/ =404;
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/snippets/seguranca.conf;
    }
}
